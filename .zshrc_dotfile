# Homebrew (macOS) — must run before tmux/mise/starship below
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
done

# Homebrew installs GNU make as gmake; prepend gnubin so `make` beats Apple's 3.81.
# Strip first so re-sourcing (tmux/exec) doesn't stack duplicates.
if [ -d "$HOMEBREW_PREFIX/opt/make/libexec/gnubin" ]; then
  path=("$HOMEBREW_PREFIX/opt/make/libexec/gnubin" ${path:#$HOMEBREW_PREFIX/opt/make/libexec/gnubin})
fi

# Create or attach to tmux session if not already in one.
if [ -z "$TMUX" ] && command -v tmux >/dev/null 2>&1; then
  if tmux has-session -t main >/dev/null 2>&1; then
    local detached_session=$(tmux list-sessions -F '#{session_name}' -f '#{&&:#{==:#{session_group},main},#{==:#{session_attached},0}}' 2>/dev/null | head -n1)
    if [ -n "$detached_session" ]; then
      tmux attach -t "$detached_session"
    else
      tmux new-session -t main \; new-window
    fi
  else
    tmux new-session -s main
  fi
fi

# Set up SSH agent bridge with Windows host on WSL2
if [[ "$IS_WSL" == true ]]; then
  source ~/.agent-bridge.sh
  init-1pw() { start_1pw_relay }
fi

# Aliases
alias esh="exec zsh"
command -v eza >/dev/null 2>&1 && alias ls="eza --icons=auto"
alias edot="code $HOME/dotfiles"

# Functions
updot() {
  echo "Updating dotfiles..."
  (cd "$HOME/dotfiles" && git pull && ./setup.sh) && exec zsh
}

zsh_history_fix() {
  echo "Fixing ZSH history file..."
  mv "$HOME/.zsh_history" "$HOME/.zsh_history_bad"
  strings "$HOME/.zsh_history_bad" > "$HOME/.zsh_history"
  fc -R "$HOME/.zsh_history"
  rm "$HOME/.zsh_history_bad"
}

# History
setopt extended_history       # record timestamp of command in HISTFILE
setopt hist_expire_dups_first # delete duplicates first when HISTFILE size exceeds HISTSIZE
setopt hist_ignore_dups       # ignore duplicated commands history list
setopt hist_ignore_space      # ignore commands that start with space
setopt hist_verify            # show command with history expansion to user before running it
setopt share_history          # share command history data
setopt hist_fcntl_lock        # fcntl locking on HISTFILE writes; cheap insurance with many concurrent shells

# Report host + cwd to the terminal on every prompt (OSC 7). tmux keeps the last
# report in #{pane_path}, which is how .tmux-status-right.sh learns where an
# SSH'd pane actually is — tmux runs locally and can't see past the ssh process.
# Prefer the stable LocalHostName over $HOST: with scutil's HostName unset,
# macOS rebuilds the transient hostname from DHCP on every network change, and
# zsh freezes $HOST at startup — so a shell that outlives a WiFi switch would
# keep reporting a name this machine no longer answers to. Resolved once per
# shell; a stale-but-stable name beats a per-prompt fork.
autoload -Uz add-zsh-hook
_osc7_host="$(scutil --get LocalHostName 2>/dev/null)"
: ${_osc7_host:=${HOST%%.*}}
_osc7_report() {
  local url=${PWD//\%/%25}
  printf '\e]7;file://%s%s\e\\' "$_osc7_host" "${url// /%20}"
}
add-zsh-hook precmd _osc7_report

# zsh-autocomplete points cdr's recent-dirs file at $XDG_DATA_HOME/zsh but never
# creates the dir, so a fresh host errors on every chpwd.
_zsh_data="${XDG_DATA_HOME:-$HOME/.local/share}/zsh"
[ -d "$_zsh_data" ] || mkdir -p "$_zsh_data"
unset _zsh_data

# Cap the cdr list; zsh-autocomplete would otherwise set it unlimited.
zstyle ':chpwd:*' recent-dirs-max 100

# Plugins
for _plugin in zsh-autosuggestions zsh-autocomplete zsh-syntax-highlighting; do
  [ -f ~/.zsh/$_plugin/$_plugin.plugin.zsh ] && source ~/.zsh/$_plugin/$_plugin.plugin.zsh
done
unset _plugin

# Directory jumping. Loads after the plugins whose key bindings it sits on top of.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Rust
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

if command -v mise >/dev/null 2>&1; then
  # Mise — drop inherited session state (via tmux/exec) first
  unset -m '__MISE_*' 2>/dev/null
  eval "$(mise activate zsh)"

  # Re-assert mise ahead of Homebrew. `brew shellenv` above and path_helper both hoist
  # /opt/homebrew/bin to the front, and mise's hook only prepends dirs *missing* from
  # PATH — it won't reorder ones inherited through tmux/exec. Without this, a formula
  # that pulls in its own node/python (e.g. mongodb-atlas-cli → mongosh → node) shadows
  # the mise-managed version and per-project pins stop taking effect.
  _mise_dirs=(${(f)"$(mise bin-paths 2>/dev/null)"} "$HOME/.local/share/mise/shims")
  for _dir in $_mise_dirs; do
    path=(${path:#$_dir})
  done
  path=($_mise_dirs $path)
  unset _dir _mise_dirs
fi

# Prompt: Starship where it's installed, otherwise a native lookalike so
# --minimal hosts keep the same ❯ without pulling in the binary
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  PROMPT='%B%F{cyan}%~%f%b
%B%(?.%F{green}.%F{red})❯%f%b '
fi
