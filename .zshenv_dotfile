local zsh_history_size=10000

# Minimal/server installs have no VS Code. GIT_EDITOR is needed as well: git
# ignores $EDITOR when core.editor is set, and .gitconfig_dotfile sets it.
if command -v code >/dev/null 2>&1; then
  export EDITOR="code"
  export VISUAL="code"
else
  export EDITOR=vi VISUAL=vi GIT_EDITOR=vi
fi
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=$zsh_history_size
export SAVEHIST=$zsh_history_size
export STARSHIP_CONFIG="$HOME/starship.toml"
export NODE_COMPILE_CACHE="$HOME/.cache/nodejs-compile-cache"
export MISE_NODE_COREPACK=true
export COLORTERM=truecolor

# systemd-enabled distros only register WSLInterop-late, so both names have to be
# tested (microsoft/WSL#8843). setup.sh sources this file and reuses $IS_WSL.
if [ -r /proc/sys/fs/binfmt_misc/WSLInterop ] || [ -r /proc/sys/fs/binfmt_misc/WSLInterop-late ]; then
  IS_WSL=true
else
  IS_WSL=false
fi

# WSL only: point browser-opening tools at the wslview shim setup.sh links.
[[ "$IS_WSL" == true ]] && export BROWSER=wslview

(( $(ulimit -n) < 65536 )) && ulimit -n 65536

# Prepend ~/.local/bin and the mise shims (shims cover non-interactive shells &
# tools that don't run `mise activate`). Hoist rather than skip-if-present: an
# inherited PATH already containing these gets them re-hoisted, since path_helper
# (/etc/paths.d/homebrew) puts /opt/homebrew/bin in front on every login shell.
# Stripping first keeps this idempotent under the re-sourcing nested shells do,
# which is why `typeset -U` isn't needed — setup.sh sources this inside a function,
# where `typeset` would shadow path with an empty local.
for _dir in "$HOME/.local/bin" "$HOME/.local/share/mise/shims"; do
  path=("$_dir" ${path:#$_dir})
done
unset _dir

skip_global_compinit=1
fpath+="$HOME/.zfunc"
