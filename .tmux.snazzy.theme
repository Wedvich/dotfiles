# Snazzy theme — minimal, task-oriented

# ─── Status bar ───────────────────────────────────────────────

set -g status-style bg=colour0,fg=colour205

# ─── Window tabs ──────────────────────────────────────────────

# Tab fg colours, consumed by the window-status formats in .tmux.conf
# (per-window: cyan when the pane is SSH'd out). dim/bold come from the
# style options below, so the SSH cyan is dim on inactive tabs too.
set -g @tab-fg '123'          # inactive, local
set -g @tab-current-fg '84'   # active, local
set -g @tab-ssh-fg '81'       # SSH'd pane — matches status-right host cyan

# Rule under a nested-tmux pane (.tmux-nested-frame.sh) — same grey as an
# inactive pane border, so it reads as chrome rather than as an active border.
set -g @nested-frame-fg '238'

set -g window-status-style fg=colour123,dim
set -g window-status-current-style fg=colour84,bold
set -g window-status-bell-style fg=colour209,bold,nodim

# ─── Pane borders (minimal — just thin colored lines) ─────────

set -g pane-border-style fg=colour238
set -g pane-active-border-style fg=colour84

# ─── Messages ─────────────────────────────────────────────────

set -g message-style bg=colour81,fg=colour17

# ─── Pane display ─────────────────────────────────────────────

set -g display-panes-active-colour colour203
set -g display-panes-colour colour84

# ─── Clock ────────────────────────────────────────────────────

set -g clock-mode-colour colour205
